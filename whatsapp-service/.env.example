PORT=3001
SITE_URL=https://wedding-invite-sand-kappa.vercel.app

# Optional shared secret. When set, every request except /health must send
# an "X-Wa-Key: <value>" header. Leave empty for local-only use.
WA_KEY=

# Random pause between bulk messages (ms). Do not lower much — WhatsApp bans blasting.
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=7000
