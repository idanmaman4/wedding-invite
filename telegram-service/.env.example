# Copy to telegram-service/.env (gitignored) and fill in real values.
# Values below are PLACEHOLDERS — never commit real secrets.
#
# The service also reads the repo-root .env.local, so a variable already set
# there (TELEGRAM_BOT_TOKEN, ADMIN_PASSWORD, …) does not need repeating here.

# From @BotFather on Telegram. NEVER commit the real token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated chat ids allowed to run the admin commands.
# Send /start to the bot and it replies with your chat id.
TELEGRAM_ADMIN_IDS=111111111,222222222

# The wedding site's API. The bot keeps its subscribers and half-finished
# flows there too (Supabase), so both are required even on a laptop.
API_BASE=https://wedding-invite-sand-kappa.vercel.app
ADMIN_PASSWORD=change-me

# Shared secret the site must send as the X-Notify-Secret header
# when it POSTs to /notify/rsvp. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NOTIFY_SECRET=replace-with-a-long-random-string

# Port for the local notify HTTP server.
PORT=8787

# Optional: how long to wait on the site API, in milliseconds.
API_TIMEOUT_MS=15000

# ── Daily XLSX export ────────────────────────────────────────────────────────
# The bot builds a workbook of everything once a day and sends it to every
# subscriber. This only fires while the service is running.

# Set to 0/false/no/off to turn the daily export off (the /export and
# /exportall commands keep working).
DAILY_EXPORT_ENABLED=true

# When to run it. A standard 5-field cron expression; default 09:00 daily.
DAILY_EXPORT_CRON=0 9 * * *

# Shorthand used ONLY when DAILY_EXPORT_CRON is unset: an hour 0-23.
# DAILY_EXPORT_HOUR=9

# Timezone for the schedule, the file name and every date in the workbook.
# Falls back to TZ, then to Asia/Jerusalem.
DAILY_EXPORT_TZ=Asia/Jerusalem
