# Copy this file to .env and fill in your values

# Database — leave empty for local SQLite dev, set for Vercel Postgres production
DATABASE_URL=

# Admin password for the /admin panel
ADMIN_PASSWORD=wedding2027

# WhatsApp microservice URL (run locally: http://localhost:3001)
WHATSAPP_SERVICE_URL=http://localhost:3001

# Public website URL (used in WhatsApp invitation messages)
SITE_URL=https://your-domain.vercel.app
